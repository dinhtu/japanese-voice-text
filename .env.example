# Copy to .env and edit. Real environment variables override these.

APP_HOST=0.0.0.0
APP_PORT=8000

# Public origin of the page. Empty = same-origin relative URLs (what a reverse
# proxy wants). Set only when the HTML is served from another host.
PUBLIC_BASE_URL=

# Proxy IPs whose X-Forwarded-* headers are trusted.
FORWARDED_ALLOW_IPS=127.0.0.1

# Extra origins for external API clients. Empty = localhost:3000 / :5173.
CORS_ORIGINS=

# Relative paths resolve from the directory you start the server in.
ASR_CHECKPOINT=models/checkpoints/best-medium-ep5-inference.pt

# Empty = use the encoder recorded in the checkpoint.
ASR_PRETRAINED=
ASR_INTER_CTC_LAYER=

# cuda | mps | cpu. Empty = auto-detect.
ASR_DEVICE=
ASR_FP16=0

# 1 = load the model at startup, 0 = on first request.
ASR_EAGER_LOAD=1

MAX_AUDIO_MB=25

# /coach: natural-language Vietnamese coaching comments, generated by a
# locally-run Ollama model (see requirements.txt for setup). Nothing here
# is sent to a third party -- the request stays on this machine (or
# wherever OLLAMA_HOST points).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_S=30
OLLAMA_TEMPERATURE=0.4

# PASQA intonation (LY Corp). Empty = auto models/pasqa/checkpoint-100000steps.pkl
# if that file exists (python scripts/download_pasqa.py). Keep device=cpu
# so the 753MB head does not share the 3060 with wav2vec2.
PASQA_CHECKPOINT=
PASQA_DEVICE=cpu

# English page /en — facebook/wav2vec2-base-960h, lazy-loaded on first
# /api/pronunciation-en/evaluate so it does not sit next to the JP ASR.
# Empty EN_ASR_DEVICE = same auto-detect as ASR_DEVICE.
EN_ASR_MODEL=facebook/wav2vec2-base-960h
EN_ASR_DEVICE=
# Chinese ASR: XLSR-53 large, outputs Hanzi; FP16 inference on CUDA.
ZH_ASR_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-chinese-zh-cn
ZH_ASR_DEVICE=

# Korean ASR: OpenAI Whisper base (~140MB), lazy-loaded; FP16 is used only on CUDA.
KO_ASR_MODEL=openai/whisper-base
KO_ASR_DEVICE=
KO_ASR_FP16=1

# English GOPT (MIT, SpeechOcean762). Empty checkpoint = models/gopt/best_audio_model.pth
# (python scripts/download_gopt.py, or first /en evaluate downloads ~121KB).
# Keep device=cpu — the transformer is tiny; GOP comes from wav2vec2 already on GPU.
GOPT_CHECKPOINT=
GOPT_DEVICE=cpu
GOPT_ENABLED=1

# "Nghe mẫu" button: reference audio from the Qwen3-TTS service
# (POST {TTS_API_URL}/api/v1/generate). The key stays on the server; the
# browser only calls /api/tts on this app. Empty key = the button falls back
# to the browser's own speech synthesis.
TTS_API_URL=https://text-to-audio.commude-vietnam.work
TTS_API_KEY=
TTS_TIMEOUT_S=120
# `language` sent per practice page. Empty TTS_SPEAKER_* = service default voice
# (list the voices with GET {TTS_API_URL}/api/v1/voices and header api-key).
TTS_LANGUAGE_JA=Japanese
TTS_LANGUAGE_EN=English
TTS_LANGUAGE_ZH=Chinese
TTS_LANGUAGE_KO=Korean
TTS_SPEAKER_JA=Ono_Anna
TTS_SPEAKER_EN=Ono_Anna
TTS_SPEAKER_ZH=Ono_Anna
TTS_SPEAKER_KO=Ono_Anna
